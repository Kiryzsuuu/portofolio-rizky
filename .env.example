# MongoDB connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=app
MONGODB_DB=portfolio

# Secret used to sign admin session cookies (use a long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# Bootstrap admin account (created automatically on first login if no users exist)
ADMIN_USERNAME=you@example.com
ADMIN_PASSWORD=change-me
